# Copiez ce fichier en ".env" pour les tests locaux,
# et renseignez les mêmes variables dans Netlify > Site settings > Environment variables
# pour la mise en production. Ne jamais committer le fichier ".env" réel dans Git.

# --- CinetPay (Mobile Money : Orange Money, MTN Money, Wave, Moov) ---
CINETPAY_API_KEY=votre_cle_api_cinetpay
CINETPAY_SITE_ID=votre_site_id_cinetpay

# --- Stripe (carte bancaire internationale) ---
STRIPE_SECRET_KEY=sk_live_votre_cle_secrete_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook_stripe

# --- Général ---
SITE_URL=https://votre-domaine.com
